# Public site URL used for canonical, Open Graph, sitemap and robots.
# Replace with your live domain before going to production.
NEXT_PUBLIC_SITE_URL=https://tracktcrm.com

# Resend API key (https://resend.com/api-keys) — server only, never NEXT_PUBLIC_
RESEND_API_KEY=

# Where contact form emails are delivered
CONTACT_TO_EMAIL=traktcrm@gmail.com

# Sender. After verifying your domain in Resend, use e.g. TracktCRM <hello@tracktcrm.com>
RESEND_FROM_EMAIL=TracktCRM <onboarding@resend.dev>
